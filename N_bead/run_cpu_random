#!/bin/bash --login
#SBATCH --time=96:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=4G
#SBATCH --job-name=DeePN_SDE
#SBATCH --constraint=agg
#SBATCH --array=1-20
#SBATCH --account=data-machine
#SBATCH --chdir=/mnt/research/MultiscaleML_group/PeiGe/DeePN_entropy/N_bead_github/N_bead
#SBATCH --output=slurm-%x-%A_%a.out

set -e
ml purge
source /mnt/ufs18/nodr/home/gepei/anaconda3/etc/profile.d/conda.sh
conda activate vscode_gpu
cd /mnt/research/MultiscaleML_group/PeiGe/DeePN_entropy/N_bead_github/N_bead
n=$SLURM_ARRAY_TASK_ID
which python3

export CUDA_VISIBLE_DEVICES=-1

# Array index n=1..20 selects the rate; the model seed is explicit.
# N7: model seed 4. Run the base first, then its continuation.
python3 main_simulation_random_N7.py $n 4 model8_macro_chain-v17_c2_sde-v2-bin32_net_40_40_N1600
python3 main_simulation_random_N7_continue.py $n 4 model8_macro_chain-v17_c2_sde-v2-bin32_net_40_40_N1600

# N15: model seed 1. Comment the N7 lines before enabling these.
# python3 main_simulation_random_N15.py $n 1 model8_macro_chain-N15-v5_c2_sde-bin40-gamma-170_net_40_40_N1600
# python3 main_simulation_random_N15_continue.py $n 1 model8_macro_chain-N15-v5_c2_sde-bin40-gamma-170_net_40_40_N1600

# To continue existing base results, enable only the corresponding continue line.

sleep 5
sacct --format=JobID,Submit,Partition,CPUTime,Elapsed,MaxRSS,NodeList,ReqCPUS --units=M -j $SLURM_JOBID
