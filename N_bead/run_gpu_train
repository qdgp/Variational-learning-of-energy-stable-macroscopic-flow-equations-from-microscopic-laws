python3 train_24eigen_v2.py model5_macro_chain-v11_c3_temp-bin2_net_100_100_N1920 $n temp-bin2
# python3 train_24eigen_v2.py model8_macro_chain-v17_c2_sde-v2-bin32_net_40_40_N1600 $n sde-v2-bin32
